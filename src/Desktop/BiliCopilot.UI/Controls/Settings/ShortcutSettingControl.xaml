<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.ShortcutSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 每个动作一张 SettingsCard，与「播放器控制」的次级菜单同构；
         条目在代码里生成（见 ShortcutSettingControl.xaml.cs），这里只留壳。 -->
    <base:SettingsExpander
        x:Name="Exp"
        Description="查看及修改播放器快捷键"
        Header="播放器快捷键">
        <base:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="KeyboardShift" />
        </base:SettingsExpander.HeaderIcon>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
