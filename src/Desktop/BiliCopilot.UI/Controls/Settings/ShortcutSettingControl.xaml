<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.ShortcutSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <base:SettingsExpander
        Description="点一下右边方框再按下新键即可改绑；撞键会自动两边对调，改坏了可以全部恢复默认。"
        Header="播放器快捷键">
        <base:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="KeyboardShift" />
        </base:SettingsExpander.HeaderIcon>
        <base:SettingsExpander.Items>
            <base:SettingsCard
                Description="快进 / 快退 / 音量只在播放控制栏隐藏时生效；统计信息覆盖层打开时，数字键 1-5 与上下键交给播放器本身。"
                Header="按键绑定">
                <StackPanel x:Name="ShortcutPanel" Spacing="6" />
            </base:SettingsCard>
            <base:SettingsCard
                Description="把所有动作的快捷键恢复成出厂设置。"
                Header="恢复默认">
                <Button
                    x:Name="ResetAllButton"
                    MinWidth="120"
                    Click="OnResetAllClick"
                    Content="全部恢复默认" />
            </base:SettingsCard>
        </base:SettingsExpander.Items>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
