<?xml version="1.0" encoding="utf-8" ?>
<local:DescriptionButtonBase
    x:Class="BiliCopilot.UI.Controls.Components.DescriptionButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Button
            x:Name="DescriptionBtn"
            AutomationProperties.Name="{ext:Locale Name=Description}"
            Click="OnDescriptionClickAsync"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="{ext:Locale Name=Description}">
            <ic:SymbolIcon FontSize="12" Symbol="Feed" />
            <Button.Flyout>
                <Flyout Placement="Bottom">
                    <TextBlock
                        x:Name="FlyoutTextBlock"
                        MaxWidth="400"
                        IsTextSelectionEnabled="True"
                        LineHeight="24"
                        TextWrapping="Wrap" />
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</local:DescriptionButtonBase>
